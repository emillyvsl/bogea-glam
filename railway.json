{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "npm ci --prefix server && npm --prefix server run db:generate" },
  "deploy": { "preDeployCommand": "npm --prefix server run db:deploy", "startCommand": "npm --prefix server start", "healthcheckPath": "/api/health", "restartPolicyType": "ON_FAILURE" }
}
