PORT=4000
DATABASE_URL=postgres://bogea:bogea_dev@localhost:5432/bogea_glam
APP_ORIGIN=http://localhost:5173
# Usados apenas para criar o primeiro administrador via seed.
ADMIN_EMAIL=admin@bogeaglam.local
# Defina 12 a 256 caracteres. Não use uma senha real neste arquivo de exemplo.
ADMIN_PASSWORD=

# InfinitePay: handle sem $, chave de checkout integrado. Segredos só no servidor.
INFINITEPAY_HANDLE=
INFINITEPAY_API_KEY=
INFINITEPAY_WEBHOOK_ENABLED=false
# Origem pública da API para webhook, exemplo: https://api.seusalao.com
PUBLIC_API_URL=

# WhatsApp via Twilio: requer remetente e modelos aprovados.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Modelos com variáveis 1=cliente, 2=data, 3=horário.
TWILIO_CONFIRMATION_SID=
TWILIO_REMINDER_SID=
# Processa a fila a cada minuto enquanto o servidor Node estiver rodando.
REMINDERS_ENABLED=false

# Alias aceito para ativar webhook; se definido, tem prioridade sobre ENABLED.
INFINITEPAY_WEBHOOK_PUBLIC=false

# WhatsApp Cloud API da Meta (token apenas no servidor).
WHATSAPP_PROVIDER=meta
META_WHATSAPP_ENABLED=false
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v25.0
META_WHATSAPP_TEST_TEMPLATE=jaspers_market_order_confirmation_v1
META_WHATSAPP_TEST_LANGUAGE=en_US
# Use modelos de agendamento aprovados, separados do modelo de teste.
META_WHATSAPP_CONFIRMATION_TEMPLATE=
META_WHATSAPP_REMINDER_TEMPLATE=
META_WHATSAPP_LANGUAGE=pt_BR
META_WHATSAPP_CONFIRMATION_FIELDS=clientName,date,time
META_WHATSAPP_REMINDER_FIELDS=clientName,date,time

# Produção: configure no Railway; não copie segredos para o frontend.
# FRONTEND_URL=https://bogeaglam.com.br
# APP_URL=https://api.bogeaglam.com.br
# INFINITEPAY_REDIRECT_URL=https://bogeaglam.com.br/pagamento-concluido
# INFINITEPAY_WEBHOOK_URL=https://api.bogeaglam.com.br/api/webhooks/infinitepay
BUSINESS_TIMEZONE=America/Rio_Branco


# Cookie de sessão: lax para frontend/API sob o mesmo domínio base HTTPS.
# Se frontend pages.dev e API railway.app: use none (HTTPS obrigatório).
COOKIE_SAME_SITE=lax
