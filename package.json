{
  "name": "bogea-glam",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "node --test server/src/scheduling.test.js server/src/password.test.js server/src/auth.test.js server/src/meta-whatsapp.test.js",
    "db:setup": "npm --prefix server run db:setup",
    "db:migrate": "npm --prefix server run db:migrate --",
    "db:deploy": "npm --prefix server run db:deploy",
    "db:seed": "npm --prefix server run db:seed",
    "db:studio": "npm --prefix server run db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
